{
  "name": "midday-meal-supply-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node build/fix-client-manifest.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "npm run build && npm run types:check && node --test tests/rendered-html.test.mjs",
    "types:check": "wrangler types worker-configuration.d.ts --config dist/server/wrangler.json --include-runtime false --check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "backup": "node create_backup.mjs"
  },
  "dependencies": {
    "@fontsource/anek-bangla": "^5.3.0",
    "@noble/hashes": "^2.3.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.26.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.2",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "type": "module"
}
